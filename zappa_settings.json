{
  "production": {
    "app_function": "finance_dashboard.wsgi_lambda.application",
    "aws_region": "ap-south-1",
    "s3_bucket": "finance-dash-zappa-prod",
    "role_arn": "arn:aws:iam::875636131680:role/finance-dash-lambda-prod",
    "runtime": "python3.11",
    "timeout_seconds": 30,
    "memory_size": 512,
    "django_settings": "finance_dashboard.settings_lambda",
    "environment_variables": {
      "DJANGO_SETTINGS_MODULE": "finance_dashboard.settings_lambda",
      "DJANGO_SECRET_KEY": "django-insecure-financial-dashboard-prod-key",
      "ALLOWED_HOSTS": "finance.karynxt.xyz"
    },
    "exclude": [
      ".git",
      ".git/**",
      ".gitignore",
      ".env",
      "**/__pycache__",
      "**/*.pyc",
      "tests",
      "tests/**",
      "venv",
      "venv/**",
      ".pytest_cache",
      ".pytest_cache/**",
      "*.md",
      "infra",
      "infra/**",
      ".terraform",
      ".terraform/**",
      "cache",
      "cache/**",
      "data",
      "data/**",
      "media",
      "media/**",
      "db.sqlite3",
      "*.xlsx",
      "*.csv",
      "key.json"
    ],
    "slim_handler": true,
    "keep_warm": false,
    "use_precompiled_packages": false
  }
}