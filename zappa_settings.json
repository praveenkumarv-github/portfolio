{
  "production": {
    "project_name": "portfolio",
    "app_function": "finance_dashboard.wsgi_lambda.application",
    "aws_region": "ap-south-1",
    "s3_bucket": "finance-dash-zappa-prod",
    "role_arn": "arn:aws:iam::875636131680:role/finance-dash-lambda-prod",
    "runtime": "python3.11",
    "timeout_seconds": 30,
    "memory_size": 1536,
    "django_settings": "finance_dashboard.settings_lambda",
    "environment_variables": {
      "DJANGO_SETTINGS_MODULE": "finance_dashboard.settings_lambda",
      "ALLOWED_HOSTS": "finance.karynxt.xyz,.amazonaws.com"
    },
    "exclude": [
      ".git",
      ".gitignore",
      ".env",
      "**/__pycache__",
      "**/*.pyc",
      "tests/**",
      "venv/**",
      ".pytest_cache/**",
      "*.md",
      "infra/**",
      ".terraform/**",
      "*.csv",
      "*.xlsx",
      "key.json",
      "*.txt",
      ".DS_Store",
      ".vscode/**",
      ".idea/**",
      "db.sqlite3",
      "./cache/**",
      "./data/**",
      "./media/**",
      "manage.py"
    ],
    "slim_handler": true,
    "use_precompiled_packages": false,
    "lambda_layers": [],
    "keep_warm": false,
    "ephemeral_storage": {
      "Size": 3072
    },
    "zip_repo": false
  }
}