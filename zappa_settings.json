{
  "production": {
    "app_function": "finance_dashboard.wsgi_lambda.application",
    "aws_region": "ap-south-1",
    "s3_bucket": "finance-dash-zappa-prod",
    "role_arn": "arn:aws:iam::875636131680:role/finance-dash-lambda-prod",
    "runtime": "python3.11",
    "timeout_seconds": 30,
    "memory_size": 512,
    "django_settings": "finance_dashboard.settings_lambda",
    "environment_variables": {
      "DJANGO_SETTINGS_MODULE": "finance_dashboard.settings_lambda",
      "DJANGO_SECRET_KEY": "django-insecure-financial-dashboard-prod-key",
      "ALLOWED_HOSTS": "finance.karynxt.xyz,.amazonaws.com,localhost,127.0.0.1"
    },
    "exclude": [
      ".git",
      ".gitignore",
      ".env",
      "**/__pycache__",
      "**/*.pyc",
      "tests/**",
      "venv/**",
      ".pytest_cache/**",
      "*.md",
      "infra/**",
      ".terraform/**",
      "*.csv",
      "*.xlsx",
      "key.json",
      "*.txt",
      ".DS_Store",
      ".vscode/**",
      ".idea/**",
      "db.sqlite3",
      "./cache/**",
      "./data/**",
      "./media/**"
    ],
    "slim_handler": true,
    "use_precompiled_packages": true,
    "lambda_layers": [],
    "keep_warm": false,
    "ephemeral_storage": {"Size": 2048}
  }
}